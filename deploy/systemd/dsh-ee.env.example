# /etc/dsh-ee/dsh-ee.env（权限 600）
DSH_EE_DSN='root@test:password@tcp(ob-host:2881)/dsh_ee'
# openssl rand -base64 32；丢了它，已存的上游 key 就解不开了
DSH_EE_SECRET_KEY=
DSH_EE_BOOTSTRAP_ADMIN=admin
DSH_EE_BOOTSTRAP_ADMIN_PASSWORD=
DSH_EE_ADDR=0.0.0.0:8080
DSH_EE_DATA_DIR=/var/lib/dsh-ee
DSH_EE_PUBLIC_URL=
# 留空时按 PUBLIC_URL 自动判断：https 就加 Secure；显式 true/false 可覆盖
DSH_EE_COOKIE_SECURE=
# 旧 ee_npm_ / sk-ee- 令牌 scope 收敛：true 时 npm 令牌只剩 registry、API key 只剩模型网关；
# 默认不收敛，避免现有客户端失效。迁到 ee_at_ 令牌后再打开（docs/token-lifecycle.md）
#DSH_EE_RESTRICT_LEGACY_TOKEN_SCOPES=true
# DeepSeek 文件/工具访问边界：默认 false 时只有管理员与机器人/服务账号能在对话里引用
# 已上传文件的 file_id（Responses 原生透传同此判断）；文件属于上游共享账号、员工之间
# 不隔离，开启前请评估风险。#160 合入后工具接口也使用同一开关。
#DSH_EE_DEEPSEEK_TOOLS_ALLOW_EMPLOYEE=true
# 刷新令牌（OAuth 风格轮换 + 复用检测），默认关闭。开启后设备登录 / 手工签发会额外返回
# ee_rt_ refresh token，POST /api/auth/refresh 可用；关闭时该端点 404、旧客户端行为不变。
# 参数含义与客户端接入见 docs/token-lifecycle.md §3
#DSH_EE_REFRESH_TOKENS=1
# refresh 换出的 access token 有效期（默认 1h，1m–24h）
#DSH_EE_REFRESH_ACCESS_TTL=1h
# 单枚 refresh token 空闲有效期（默认 720h=30 天）；令牌族绝对上限默认 4320h=180 天
#DSH_EE_REFRESH_TOKEN_TTL=720h
#DSH_EE_REFRESH_FAMILY_TTL=4320h
# 轮换宽限（默认 0 严格；>0 时客户端丢响应后的重试会原样返回上次结果）
#DSH_EE_REFRESH_GRACE=0
# /v1/*、/beta/* 与 /mcp 的每令牌限流（次/分钟），默认 60；0 或 off 关闭
#DSH_EE_RATE_LIMIT=60
# DeepSeek FIM / Chat Prefix beta 透传（/beta/*）用哪个启用中的 vendor=deepseek 上游（name 或 id）；
# 留空时取优先级最高的 DeepSeek 上游，没有可用上游时 /beta/* 返回 503
#DSH_EE_DEEPSEEK_PROVIDER=
# API 客户端（client_credentials）每 IP 每分钟换 token 次数，默认 120；0 或 off 关闭（只防撞库）
#DSH_EE_CLIENT_TOKEN_PER_MINUTE=120
# 多实例后台任务租约（默认开启，单实例也安全）：周期任务每轮先抢数据库租约，只有 leader 执行
#DSH_EE_BACKGROUND_LEASE=true
# 租约有效期，默认 90s（1s–1h）；持有实例按 1/3 续约，进程崩溃后最多这么久其他实例才能接管
#DSH_EE_BACKGROUND_LEASE_TTL=90s
# DeepSeek Files（上游账号级共享文件）的 file_id 访问拦截：默认 false（fail closed）。
# 员工请求里引用 file_id / document.source.file_id 会被 403 file_access_denied（不请求上游）；
# 管理员（任一管理权限）与 account_type=bot 机器人账号始终放行。只有确实要让全体员工
# 引用管理员上传的共享文件时才设成 true；非法值启动失败。
#DSH_EE_DEEPSEEK_TOOLS_ALLOW_EMPLOYEE=false
# 登录失败按客户端 IP 限流：窗口内失败多少次返回 429；默认 50 次 / 15m，设成 0 关闭。
# 公司很多人共用一个出口 IP（NAT）时按人数调大，否则会误伤正常登录。
#DSH_EE_LOGIN_IP_LIMIT=50
#DSH_EE_LOGIN_IP_WINDOW=15m
# 给 Prometheus 抓取的最小指标接口 GET /metrics；默认关闭，开启后也只允许本机 / 内网来源。
#DSH_EE_METRICS=true
# 数据中台：默认在同一个服务器上建「主库名_data」，并自动建一个只读账号；设成 off 关闭
#DSH_EE_DATA_DSN='dsh_ee@your_tenant:password@tcp(ob-host:2881)/dsh_ee_data'
# 账号没有建用户的权限时，请 DBA 建一个只有这个库 SELECT 权限的账号填在这里
#DSH_EE_DATA_READ_DSN='dsh_ee_reader@your_tenant:password@tcp(ob-host:2881)/dsh_ee_data'
# 反向代理不在本机（含 dsh-ee 跑在容器里、由宿主机 nginx 转发）时，填代理地址/网段，逗号分隔；
# 只有来自这些地址的 X-Forwarded-For/Host/Proto 会被采信，默认只有 127.0.0.1 与 ::1
#DSH_EE_TRUSTED_PROXIES=172.17.0.0/16
# 扩展签名：受信任的签名公钥（PEM，可以放多把）；REQUIRE=1 时没签名或签名无效的扩展不让安装
#DSH_EE_EXTENSION_TRUSTED_KEYS=/etc/dsh-ee/extension-signing-keys.pem
#DSH_EE_EXTENSION_REQUIRE_SIGNATURE=0
# DeepSeek Chatbot（docs/dev/chatbot.md）：只对 vendor=deepseek 的上游请求生效；客户端已传对应字段时保留。
# safety_check=high 开启基础风控（客户端要处理拒绝响应），title=on 生成会话标题；默认都关闭。
#DSH_EE_SAFETY_CHECK=high
#DSH_EE_CHAT_TITLE=on
# 企业目录：tarball 来源的主机白名单（逗号分隔，支持 *.example.com）；不设时只接受公网 https 地址
#DSH_EE_DIRECTORY_TARBALL_HOSTS='cdn.acme.internal,*.objects.acme.com'
# 内容安全策略：不设置时默认 enforce（下发内置基线策略）；off 显式关闭完整策略、
# 只保留 frame-ancestors 嵌入收口（升级前行为，回滚用）/ report 只报告不阻断。
# 升级注意：旧版本默认 off，升级后未显式设置 DSH_EE_CSP 的部署会自动 enforce；
# 有兼容问题时先设 report 观察，或设 off 回滚。见 docs/operations.md §10.1
#DSH_EE_CSP=off
# CSP 违规报告地址（可选）；dsh-ee 不自带收集端点
#DSH_EE_CSP_REPORT_URI=https://ee.example.com/api/csp-report
# DeepSeek 工具代理（docs/dev/deepseek-tools.md）：Files / ASR / TTS / Search / Fetch / OCR 与
# Anthropic 兼容 Files 用哪个模型上游转发。
# 填「模型接入」里 provider 的 name 或数字 id；不填时用第一个启用且 vendor=deepseek 的上游。
# 这些调用按上游工具计费，不占 token 额度；文件/音频在 dsh-ee 不落盘。
#DSH_EE_DEEPSEEK_PROVIDER=deepseek-main
# 默认只有管理员与机器人/服务账号能调用文件/工具接口；文件属于上游共享账号、员工之间不隔离。
# 需要普通员工也能上传/引用文件时再设 true（聊天里的 file_id 引用也会一并放开）。
#DSH_EE_DEEPSEEK_TOOLS_ALLOW_EMPLOYEE=false
